DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
SHARED_ACCESS_ENABLED=true
HOST=127.0.0.1
PORT=3080
DAILY_GLOBAL_LIMIT=100
DAILY_IP_LIMIT=30
MAX_OUTPUT_TOKENS=800
# Expensive model calls are bounded in memory; keep these conservative on 2c2g.
MODEL_CONCURRENCY=2
MODEL_QUEUE_LIMIT=6
MODEL_QUEUE_WAIT_MS=15000
