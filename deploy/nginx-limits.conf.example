# Include this file inside nginx's http{} context (for example,
# /etc/nginx/conf.d/shudong-limits.conf).
limit_req_zone $binary_remote_addr zone=shudong_api:10m rate=5r/s;
limit_conn_zone $binary_remote_addr zone=shudong_conn:10m;
limit_req_status 429;

