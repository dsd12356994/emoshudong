[Unit]
Description=Huisheng private treehole
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=shudong
Group=shudong
WorkingDirectory=/opt/shudong/app
EnvironmentFile=/etc/shudong.env
Environment=NODE_ENV=production
ExecStart=/opt/shudong/node/bin/node /opt/shudong/app/server.mjs
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/opt/shudong/app/data
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
LockPersonality=true
UMask=0077
MemoryMax=350M
TasksMax=64
LimitNOFILE=4096

[Install]
WantedBy=multi-user.target
